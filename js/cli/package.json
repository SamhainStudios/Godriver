{
	"name": "@godriver/cli",
	"version": "0.1.0",
	"description": "Command line interface and fail-fast watchdog runner for Godriver",
	"type": "module",
	"bin": {
		"godriver": "./bin/godriver.js"
	},
	"main": "src/index.js",
	"exports": {
		".": "./src/index.js",
		"./launcher": "./src/launcher.js",
		"./watchdog": "./src/watchdog.js"
	},
	"engines": {
		"node": ">=24"
	},
	"files": [
		"bin",
		"src",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"@godriver/core": "0.2.0",
		"@godriver/cucumber": "0.1.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SamhainStudios/godriver.git",
		"directory": "js/cli"
	},
	"homepage": "https://github.com/SamhainStudios/godriver/tree/master/js/cli#readme",
	"bugs": "https://github.com/SamhainStudios/godriver/issues",
	"publishConfig": {
		"access": "public"
	}
